{
  "name": "platform",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "dev:db": "node --experimental-strip-types src/devdb.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:e2e": "node --env-file-if-exists=.env test/acceptance.mjs",
    "db:reset": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "build": "npm --prefix web install --no-audit --no-fund && npm --prefix web run build",
    "start:prod": "node --experimental-strip-types src/server.ts",
    "db:init": "node scripts/db-init.mjs",
    "seed:admins": "node --experimental-strip-types scripts/seed-admins.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "^5.7.2",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": "24.x"
  }
}
