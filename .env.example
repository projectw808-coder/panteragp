DATABASE_URL=postgres://platform:platform@localhost:5432/platform
JWT_SECRET=
PORT=3000

# Client email. Unset, the feature reports itself unconfigured and offers no button.
# SMTP_FROM is always needed. Then one way out:
#   POSTMARK_SERVER_TOKEN  — Postmark's HTTPS API; works on hosts that block outbound SMTP
#                            (Railway does below its Pro plan). Preferred when set.
#   SMTP_HOST (+ SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_SECURE) — any SMTP server.
# SMTP_FROM=Pantera GP <support@example.com>
# POSTMARK_SERVER_TOKEN=
# SMTP_MESSAGE_STREAM=broadcast
# PUBLIC_URL=https://www.example.com
